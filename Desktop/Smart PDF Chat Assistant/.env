import os
from google import genai

# यहाँ "AIzaSy..." भएको ठाउँमा आफ्नो Google AI Studio को वास्तविक API Key राख्नुहोस्
client = genai.Client(
    api_key="तपाईंको_वास्तविक_API_Key_यहाँ_राख्नुहोस्",
)

tools = [
    {
        'type': 'google_search',
    },
]

generation_config = {
    'temperature': 1,
    'max_output_tokens': 65536,
    'top_p': 0.95,
    'thinking_level': 'high',
}

interaction = client.interactions.create(
    model='models/gemini-3-flash-preview',
    input="नेपालको बारेमा केही भन्नुहोस्",  # यहाँ आफ्नो प्रश्न लेख्नुहोला
    tools=tools,
    generation_config=generation_config,
)

print(interaction.steps[-1])